FROM python:3.11-slim

# Install system dependencies required by Docling (Tesseract, Poppler, OpenCV)
RUN apt-get update && apt-get install -y \
    tesseract-ocr \
    tesseract-ocr-eng \
    poppler-utils \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download ALL Docling models (PDF + image OCR pipeline)
# This runs the full image pipeline to cache RapidOCR + HuggingFace layout models
RUN python -c "
import urllib.request, os, tempfile
from docling.document_converter import DocumentConverter
from docling.datamodel.base_models import InputFormat
from docling.datamodel.pipeline_options import PipelineOptions, EasyOcrOptions, RapidOcrOptions

# Initialize converter (downloads layout models from HuggingFace)
converter = DocumentConverter()

# Create a tiny 1x1 white JPEG to trigger the full image OCR model downloads
img_bytes = bytes([
    0xff,0xd8,0xff,0xe0,0x00,0x10,0x4a,0x46,0x49,0x46,0x00,0x01,0x01,0x00,0x00,0x01,
